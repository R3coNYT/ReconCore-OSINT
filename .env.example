# ===========================================================================
# ReconCore OSINT - example configuration.
# Copy to `.env`, then replace EVERY value marked CHANGE_ME.
#   cp .env.example .env
#   python scripts/gen_secrets.py --write   # generates safe values for the keys
# ===========================================================================

# --- General ---------------------------------------------------------------
RECONCORE_ENV=development                 # development | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Security (REQUIRED) ---------------------------------------------------
# SECRET_KEY: JWT signing key. At least 32 random characters.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# SECRETS_ENCRYPTION_KEY: Fernet key (url-safe base64, 32 bytes) used to encrypt
# plugin secrets at rest (e.g. the Toutatis Instagram session cookie).
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=CHANGE_ME_fernet_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Administrator account created on first run (scripts/bootstrap.py)
FIRST_ADMIN_EMAIL=admin@example.org
FIRST_ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=reconcore
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=reconcore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Retention policy ------------------------------------------------------
# 0 = no automatic deletion.
DATA_RETENTION_DAYS=0
AUDIT_LOG_RETENTION_DAYS=365

# --- Plugin outbound network ----------------------------------------------
# Legitimate proxy (corporate / dedicated egress). Leave empty for direct.
OSINT_HTTP_PROXY=
OSINT_HTTPS_PROXY=
# Maximum plugin execution time, in seconds.
PLUGIN_DEFAULT_TIMEOUT=300

# --- PhoneInfoga plugin ----------------------------------------------------
# URL of the PhoneInfoga container in REST mode. Empty => local mode (no
# outbound request, query generation only).
PHONEINFOGA_API_URL=http://phoneinfoga:5000

# --- Toutatis plugin (OPTIONAL, disabled by default) -----------------------
# Toutatis requires an Instagram `sessionid` cookie. NEVER put a password here.
# The cookie is encrypted with SECRETS_ENCRYPTION_KEY before storage; configure
# it through the UI (Settings > Plugins > Toutatis) or with
# `osint plugin secret set toutatis sessionid`. See docs/PLUGINS.md.
TOUTATIS_ENABLED=false

# --- Web search ------------------------------------------------------------
# The websearch plugin generates queries (dorks) without running them by
# default. To actually execute searches, provide an API key for a supported
# engine. No key => query-generation mode only.
# See docs/PLUGINS.md#websearch--targeted-queries for how to obtain these keys.
SEARCH_PROVIDER=none                      # none | searxng | serpapi | brave
SEARXNG_BASE_URL=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
